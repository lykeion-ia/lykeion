{
  "name": "@lykeion/daemon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The per-machine process that pairs with a lab and reports what it can run.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js",
    "start": "pnpm build && node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lykeion/api": "workspace:*",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
