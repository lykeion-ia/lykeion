# Loaded by `vite --mode lab`, which is what `pnpm dev:lab` runs. It tells
# the app that a workspace server sits behind the dev server's proxy, so it
# builds the HTTP data layer instead of the seeded in-browser one.
#
# A mode file rather than a variable set on the command line: `VAR=value cmd`
# is POSIX syntax, and the package manager runs scripts through cmd.exe on
# Windows, where that form is read as a command name.
VITE_LYKEION_WORKSPACE=1
