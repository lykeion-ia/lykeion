{
  "name": "@lykeion/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The lab's workspace server: durable storage, identity, and the change channel behind LykeionApi.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js",
    "start": "pnpm build && node --experimental-sqlite dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@lykeion/api": "workspace:*",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.0"
  }
}
